{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "our-bank-bybit-dryrun",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 100,
  "trading_mode": "spot",
  "timeframe": "1h",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1, "price_last_balance": 0.0},
  "exit_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "dataformat_ohlcv": "feather",
  "user_data_dir": "user_data",
  "strategy_path": "strategies",
  "db_url": "sqlite:///user_data/tradesv3.dryrun.sqlite",
  "initial_state": "running",
  "internals": {"process_throttle_secs": 5}
}
