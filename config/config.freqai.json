{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "add_config_files": ["config.backtest.json"],
  "bot_name": "our-bank-freqai",
  "strategy": "FreqAIStrategy",
  "freqaimodel": "LightGBMRegressor",
  "freqai_strategy": {
    "entry_threshold": 0.006,
    "exit_threshold": 0.0
  },
  "freqai": {
    "enabled": true,
    "identifier": "lgbm-reg-v1-dev",
    "purge_old_models": 2,
    "train_period_days": 180,
    "backtest_period_days": 30,
    "live_retrain_hours": 24,
    "expiration_hours": 2,
    "save_backtest_models": false,
    "write_metrics_to_disk": false,
    "activate_tensorboard": false,
    "continual_learning": false,
    "feature_parameters": {
      "include_timeframes": ["1h", "4h"],
      "include_corr_pairlist": ["BTC/USDT", "ETH/USDT"],
      "label_period_candles": 12,
      "include_shifted_candles": 1,
      "indicator_periods_candles": [8, 16, 32],
      "weight_factor": 0.9,
      "DI_threshold": 0,
      "use_SVM_to_remove_outliers": true,
      "svm_params": {"shuffle": false, "nu": 0.05},
      "principal_component_analysis": false,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.1,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 300,
      "learning_rate": 0.03,
      "num_leaves": 15,
      "min_child_samples": 50,
      "subsample": 0.8,
      "subsample_freq": 1,
      "colsample_bytree": 0.5,
      "reg_lambda": 1.0,
      "random_state": 42,
      "n_jobs": 4,
      "verbosity": -1
    }
  }
}
